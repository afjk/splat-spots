{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src",
    "scripts",
    "tests"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "worker"
  ],
  "compilerOptions": {
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
