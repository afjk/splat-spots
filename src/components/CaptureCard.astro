---
import CaptureArt from "./CaptureArt.astro";
import { href } from "../lib/url";
import { displayDate, type CaptureRecord } from "../lib/catalog";

interface Props {
  capture: CaptureRecord;
}

const { capture } = Astro.props;
const detail = href(`/s/${capture.id}`);
const date = displayDate(capture.captured_at);

// Filtered client-side without shipping a framework runtime.
const haystack = [
  capture.title,
  capture.description,
  capture.author ?? "",
  capture.camera ?? "",
  ...capture.tags,
]
  .join(" ")
  .toLowerCase();
---

<article class="capture-card" data-capture data-search={haystack} data-tags={capture.tags.join(" ")}>
  <a class="capture-visual" href={detail}>
    <CaptureArt id={capture.id} label={capture.title} />
    <span class="visual-overlay">
      <span class="visual-kicker">Splat Spot</span>
      <span class="visual-meta">
        {capture.tags[0] && <span>{capture.tags[0]}</span>}
        {capture.camera && <span>{capture.camera}</span>}
        {date && <span>{date}</span>}
      </span>
      <span class="visual-cta">View Spatial Capture →</span>
    </span>
  </a>
  <div class="capture-body">
    <h3><a href={detail}>{capture.title}</a></h3>
    {capture.description && <p class="capture-blurb">{capture.description}</p>}
    {capture.author && <p class="capture-meta"><span>{capture.author}</span></p>}
    {capture.tags.length > 0 && (
      <div class="capture-tags">
        {capture.tags.map((tag) => <span>#{tag}</span>)}
      </div>
    )}
  </div>
</article>
