---
import Base from "../../layouts/Base.astro";
import { captures, displayDate } from "../../lib/catalog";
import { viewerUrl } from "../../lib/viewer";
import { href } from "../../lib/url";

export function getStaticPaths() {
  return captures.map((capture) => ({
    params: { id: capture.id },
    props: { capture },
  }));
}

const { capture } = Astro.props;
const launch = viewerUrl(capture.id);
const date = displayDate(capture.captured_at);
const reportUrl = href(`/report?capture=${encodeURIComponent(capture.id)}`);
---

<Base
  title={capture.title}
  description={capture.description || `${capture.title} — 公開 Insta360 Spatial Capture を WebXR で。`}
  path={`/s/${capture.id}`}
>
  <section class="viewer-head shell">
    <a class="back-link" href={href("/")}>← Gallery</a>
    <h1>{capture.title}</h1>
    {capture.description && <p class="lede">{capture.description}</p>}
    <div class="viewer-actions">
      <a class="btn btn-primary" href={launch} target="_blank" rel="noreferrer">
        フルスクリーンで開く / Enter VR ↗
      </a>
      <a class="btn btn-ghost" href={capture.insta360_url} target="_blank" rel="noreferrer">
        Insta360 で見る ↗
      </a>
    </div>
  </section>

  <section class="shell">
    <div class="stage">
      <div class="stage-bar">
        <span class="dot" aria-hidden="true"></span>
        <span>WEBXR VIEWER</span>
        <code>{capture.id}</code>
        <a href={launch} target="_blank" rel="noreferrer">Fullscreen ↗</a>
      </div>
      <iframe
        src={launch}
        title={`${capture.title} の WebXR ビューア`}
        allow="fullscreen; xr-spatial-tracking; accelerometer; gyroscope"
        allowfullscreen
        loading="lazy"
      ></iframe>
      <p class="stage-note">
        デスクトップ: ドラッグで視点移動 · Quest / PICO: 「フルスクリーンで開く」から VR に入れます
      </p>
    </div>
  </section>

  <section class="detail shell">
    <div>
      <p class="eyebrow">Catalog record</p>
      <dl>
        <div><dt>Capture ID</dt><dd><code>{capture.id}</code></dd></div>
        {date && <div><dt>撮影日</dt><dd>{date}</dd></div>}
        {capture.camera && <div><dt>カメラ</dt><dd>{capture.camera}</dd></div>}
        <div><dt>撮影者</dt><dd>{capture.author ?? "未確認"}</dd></div>
        <div>
          <dt>出典</dt>
          <dd>
            {capture.source_post ? (
              <a href={capture.source_post} target="_blank" rel="noreferrer">
                {capture.source_post}
              </a>
            ) : ("記載なし")}
          </dd>
        </div>
        <div><dt>掲載日</dt><dd>{displayDate(capture.submitted_at) ?? capture.submitted_at}</dd></div>
        <div>
          <dt>ホスティング</dt>
          <dd>
            Capture 本体は Insta360 が配信しています。Splat Spots はリンクと
            上記の情報だけを持っています。
          </dd>
        </div>
      </dl>
    </div>

    <aside class="side-card">
      <p class="eyebrow">Creator control</p>
      <p>
        この空間の撮影者・権利者の方へ。掲載の停止や情報の修正はいつでも受け付けます。
        ご連絡いただければ速やかに掲載を外します。
      </p>
      <a class="block" href={reportUrl}>Report / Request removal →</a>
    </aside>
  </section>
</Base>
