---
import Base from "../layouts/Base.astro";
import { API_CONFIGURED, apiUrl } from "../lib/api";
import { href } from "../lib/url";

const endpoint = apiUrl("/api/submissions");
---

<Base
  title="Add a spot"
  description="公開されている Insta360 Spatial Capture を Splat Spots に追加する。"
  path="/submit"
>
  <section class="form-page shell">
    <a class="back-link" href={href("/")}>← Gallery</a>
    <h1>スポットを追加する</h1>
    <p class="lede">
      URL を貼れば、そのままギャラリーに並びます。自分で撮ったものでなくても構いません。
    </p>
    <p class="notice">
      <strong>すでに一般公開されている Capture だけを追加してください。</strong><br />
      Please add only Spatial Captures that are already publicly accessible.
    </p>

    {API_CONFIGURED ? (
      <form class="form-grid" id="submit-form" data-endpoint={endpoint} novalidate>
        <div class="field field-wide">
          <label for="submission_key">投稿キー <b>*</b></label>
          <input
            id="submission_key"
            name="submission_key"
            type="password"
            autocomplete="off"
            required
          />
          <span class="hint">投稿キーを持っている人だけ追加できます。</span>
        </div>

        <div class="field field-wide">
          <label for="url">Spatial Capture の公開URL <b>*</b></label>
          <input
            id="url"
            name="url"
            type="url"
            inputmode="url"
            placeholder="https://app.insta360.com/3dspace/detail/GS3DG…"
            autocomplete="off"
            required
          />
          <div class="id-preview" id="id-preview">
            <span class="marker" aria-hidden="true">→</span>
            <div>
              <small>Capture ID</small>
              <code id="id-value">GS3DG…</code>
              <p id="id-error" hidden></p>
            </div>
          </div>
        </div>

        <div class="field field-wide">
          <label for="title">タイトル <span>任意</span></label>
          <input id="title" name="title" maxlength="120" placeholder="例：夜の日本橋を歩く" />
        </div>

        <div class="field">
          <label for="author">撮影者 <span>任意</span></label>
          <input id="author" name="author" maxlength="80" placeholder="@creator" />
        </div>

        <div class="field">
          <label for="source_post">出典URL <span>任意</span></label>
          <input id="source_post" name="source_post" type="url" inputmode="url"
            placeholder="https://… (見かけた投稿など)" />
        </div>

        <div class="field field-wide">
          <label for="note">説明 <span>任意</span></label>
          <textarea id="note" name="note" maxlength="600" rows="3"
            placeholder="どんな場所か。"></textarea>
        </div>

        <div class="field field-wide">
          <label for="tags">タグ <span>任意・カンマ区切り・最大6個</span></label>
          <input id="tags" name="tags" maxlength="200" placeholder="tokyo, night, architecture" />
        </div>

        <div class="field field-wide">
          <label for="thumbnail-input">サムネイル <span>任意</span></label>
          <div class="dropzone" id="dropzone" role="button" tabindex="0"
            aria-controls="thumbnail-status" aria-label="サムネイルの画像を選ぶ">
            <input class="sr-only" id="thumbnail-input" type="file" accept="image/*" />
            <div class="dropzone-empty" id="dropzone-empty">
              <span class="dropzone-mark" aria-hidden="true">＋</span>
              <p>クリックして選ぶ・ドラッグ・そのまま貼り付け</p>
              <small>大きさも縦横比もそのままで大丈夫です</small>
            </div>
            <div class="dropzone-preview" id="dropzone-preview" hidden>
              <img id="thumbnail-preview" alt="サムネイルのプレビュー" />
              <button class="dropzone-clear" id="thumbnail-clear" type="button">画像を外す</button>
            </div>
          </div>
          <span class="hint" id="thumbnail-status" role="status">
            指定しなければ、Capture ID から生成した絵がカードになります。
          </span>
        </div>

        <div class="honeypot" aria-hidden="true">
          <label for="website">Website</label>
          <input id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <p class="form-message is-error" id="form-error" role="alert" hidden></p>
        <div class="form-message is-success" id="form-success" role="status" hidden></div>

        <div class="form-actions field-wide">
          <button class="btn btn-primary" type="submit" id="submit-button">追加する</button>
          <span class="hint" id="submit-hint" hidden>送信しています…</span>
        </div>
      </form>
    ) : (
      <div class="api-missing">
        <p class="eyebrow">Not configured</p>
        <h2>受付APIがまだ設定されていません。</h2>
        <p>
          ビルド時に <code>PUBLIC_API_BASE_URL</code> が設定されていないため、
          いまは受け付けられません。リポジトリから直接追加することもできます。
        </p>
        <pre>node scripts/add-capture.mts '&lt;共有URL&gt;' --title '…' --tags 'tokyo'</pre>
      </div>
    )}
  </section>
</Base>

<script>
  import { normalizeCaptureInput } from "../lib/capture-id";
  import { imageFrom, normalizeThumbnail } from "../lib/thumbnail";
  import { href } from "../lib/url";

  const form = document.getElementById("submit-form") as HTMLFormElement | null;
  if (form) {
    // The message sits below a long form; showing it is not enough if it lands
    // off-screen, so move it into view whenever it appears.
    const reveal = (element: HTMLElement) => {
      element.hidden = false;
      element.scrollIntoView({ behavior: "smooth", block: "center" });
    };
    const urlInput = document.getElementById("url") as HTMLInputElement;
    const preview = document.getElementById("id-preview")!;
    const marker = preview.querySelector(".marker")!;
    const idValue = document.getElementById("id-value")!;
    const idError = document.getElementById("id-error")!;
    const errorBox = document.getElementById("form-error")!;
    const successBox = document.getElementById("form-success")!;
    const button = document.getElementById("submit-button") as HTMLButtonElement;
    const hint = document.getElementById("submit-hint")!;

    // The browser and `npm run add` share this validator, so a URL accepted
    // here is accepted by the importer for the same reasons.
    function readId(): string | null {
      const raw = urlInput.value.trim();
      if (!raw) {
        preview.className = "id-preview";
        marker.textContent = "→";
        idValue.textContent = "GS3DG…";
        idError.hidden = true;
        return null;
      }
      try {
        const id = normalizeCaptureInput(raw);
        preview.className = "id-preview is-valid";
        marker.textContent = "✓";
        idValue.textContent = id;
        idError.hidden = true;
        return id;
      } catch (error) {
        preview.className = "id-preview is-error";
        marker.textContent = "!";
        idValue.textContent = "—";
        idError.textContent = error instanceof Error ? error.message : "URLを確認してください。";
        idError.hidden = false;
        return null;
      }
    }

    // The listing is live by the time this runs, so the message is a way in.
    function published(id: string) {
      successBox.replaceChildren();
      const line = document.createElement("strong");
      line.textContent = "追加しました。";
      const spot = document.createElement("a");
      spot.href = href(`/s/${id}`);
      spot.textContent = "このスポットを開く";
      const gallery = document.createElement("a");
      gallery.href = href("/");
      gallery.textContent = "ギャラリーへ";
      successBox.append(line, " ", spot, " · ", gallery);
      reveal(successBox);
    }

    // ---- thumbnail ------------------------------------------------------
    // Optional, and deliberately forgiving: choose a file, drag one in, or
    // just paste. Whatever arrives is refitted to the card's frame in the
    // browser, so nobody has to think about size or ratio.
    const dropzone = document.getElementById("dropzone")!;
    const fileInput = document.getElementById("thumbnail-input") as HTMLInputElement;
    const emptyState = document.getElementById("dropzone-empty")!;
    const previewState = document.getElementById("dropzone-preview")!;
    const previewImage = document.getElementById("thumbnail-preview") as HTMLImageElement;
    const clearButton = document.getElementById("thumbnail-clear")!;
    const thumbnailStatus = document.getElementById("thumbnail-status")!;
    const IDLE_HINT = thumbnailStatus.textContent ?? "";

    let thumbnail: string | null = null;
    let processing = false;

    function clearThumbnail() {
      thumbnail = null;
      fileInput.value = "";
      previewImage.removeAttribute("src");
      previewState.hidden = true;
      emptyState.hidden = false;
      dropzone.classList.remove("has-image");
      thumbnailStatus.textContent = IDLE_HINT;
    }

    async function acceptImage(file: File | null) {
      if (!file || processing) return;
      processing = true;
      dropzone.classList.add("is-busy");
      thumbnailStatus.textContent = "画像を整えています…";

      try {
        thumbnail = await normalizeThumbnail(file);
        previewImage.src = thumbnail;
        emptyState.hidden = true;
        previewState.hidden = false;
        dropzone.classList.add("has-image");
        // Roughly what will be uploaded: base64 costs about a third extra.
        const kilobytes = Math.round((thumbnail.length * 3) / 4 / 1024);
        thumbnailStatus.textContent = `カードの形に合わせました（約 ${kilobytes} KB）。`;
      } catch (error) {
        clearThumbnail();
        thumbnailStatus.textContent =
          error instanceof Error ? error.message : "画像を読み取れませんでした。";
      } finally {
        processing = false;
        dropzone.classList.remove("is-busy");
      }
    }

    dropzone.addEventListener("click", () => fileInput.click());
    dropzone.addEventListener("keydown", (event) => {
      if (event.key !== "Enter" && event.key !== " ") return;
      event.preventDefault();
      fileInput.click();
    });
    fileInput.addEventListener("change", () => void acceptImage(fileInput.files?.[0] ?? null));

    clearButton.addEventListener("click", (event) => {
      // The whole zone opens the picker; removing must not reopen it.
      event.stopPropagation();
      clearThumbnail();
    });

    for (const type of ["dragenter", "dragover"]) {
      dropzone.addEventListener(type, (event) => {
        event.preventDefault();
        dropzone.classList.add("is-over");
      });
    }
    for (const type of ["dragleave", "dragend"]) {
      dropzone.addEventListener(type, () => dropzone.classList.remove("is-over"));
    }
    dropzone.addEventListener("drop", (event) => {
      event.preventDefault();
      dropzone.classList.remove("is-over");
      void acceptImage(imageFrom((event as DragEvent).dataTransfer));
    });

    // Anywhere on the page: pasting a screenshot is how most people will do
    // this, and hunting for the right box first is friction.
    document.addEventListener("paste", (event) => {
      const file = imageFrom((event as ClipboardEvent).clipboardData);
      if (!file) return;
      event.preventDefault();
      void acceptImage(file);
    });

    urlInput.addEventListener("input", () => {
      readId();
      errorBox.hidden = true;
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const id = readId();
      errorBox.hidden = true;
      successBox.hidden = true;

      if (!id) {
        errorBox.textContent = "先に有効な公開URLを入力してください。";
        reveal(errorBox);
        urlInput.focus();
        return;
      }
      if (processing) {
        errorBox.textContent = "画像の処理が終わるまで少しお待ちください。";
        reveal(errorBox);
        return;
      }

      const data = new FormData(form);
      button.disabled = true;
      hint.hidden = false;

      try {
        const response = await fetch(form.dataset.endpoint!, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            submission_key: data.get("submission_key"),
            url: id,
            title: data.get("title"),
            author: data.get("author"),
            source_post: data.get("source_post"),
            note: data.get("note"),
            tags: data.get("tags"),
            thumbnail,
            website: data.get("website"),
          }),
        });
        const payload = (await response.json().catch(() => null)) as
          | { ok?: boolean; error?: string }
          | null;

        if (!response.ok || !payload?.ok) {
          throw new Error(payload?.error ?? "送信できませんでした。時間をおいて試してください。");
        }

        published(id);
        form.reset();
        clearThumbnail();
        readId();
      } catch (error) {
        errorBox.textContent =
          error instanceof Error ? error.message : "送信できませんでした。";
        reveal(errorBox);
      } finally {
        button.disabled = false;
        hint.hidden = true;
      }
    });
  }
</script>
