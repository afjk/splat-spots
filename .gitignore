# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

/dist/
.wrangler/
/outputs/
/work/

# astro
/.astro/

# cloudflare local secrets
.dev.vars

# Derived thumbnails are build artifacts, never committed. Keeping them out of
# git is what makes a removal request actually complete: delete the record and
# the images cease to exist rather than surviving in history.
/public/thumbs/
